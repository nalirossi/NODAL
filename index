<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NODAL // Pro Studio</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');
  
  :root {
    --bg-main: #0a0a0a;
    --panel-bg: #141414;
    --text-primary: #f0f0f0;
    --text-muted: #777777;
    --accent: #ffeb3b; 
    --accent-hover: #ffd600;
    --border: #2a2a2a;
    --radius: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body { font-family: 'IBM Plex Mono', monospace; background: var(--bg-main); color: var(--text-primary); font-size: 11px; height: 100vh; overflow: hidden; }
  
  .app-shell { display: grid; grid-template-columns: 380px 1fr; height: 100vh; overflow: hidden; }
  @media (max-width: 900px) { 
    .app-shell { grid-template-columns: 1fr; height: auto; overflow: auto; } 
    body { height: auto; overflow: auto; }
    .right-panel { height: 65vh !important; } 
  }
  
  .left-panel { background: var(--panel-bg); border-right: 1px solid var(--border); overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 20px; height: 100%; }
  .left-panel::-webkit-scrollbar { width: 6px; }
  .left-panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  
  .brand { border-bottom: 1px solid var(--border); padding-bottom: 12px; display: flex; justify-content: space-between; align-items: flex-end; }
  .brand h1 { font-size: 22px; font-weight: 700; letter-spacing: 0.05em; color: var(--accent); line-height: 1; }
  .brand p { font-size: 9px; color: var(--text-muted); text-transform: uppercase; margin-top: 6px; }

  .history-nav { display: flex; gap: 6px; }
  .history-nav button { background: #222; border: 1px solid var(--border); color: #fff; border-radius: 4px; padding: 4px 10px; cursor: pointer; font-size: 14px; transition: 0.2s; }
  .history-nav button:hover:not(:disabled) { background: var(--text-primary); color: #000; }
  .history-nav button:disabled { opacity: 0.3; cursor: not-allowed; }

  .section { background: #1a1a1a; border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .section-title { font-size: 10px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.1em; display: flex; align-items: center; gap: 8px; }
  .section-title::before { content: ""; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  
  .lock-btn { font-size: 14px; cursor: pointer; opacity: 0.3; transition: all 0.2s; user-select: none; background: none; border: none; padding: 0; outline: none; filter: grayscale(1); }
  .lock-btn:hover { opacity: 0.8; }
  .lock-btn.locked { opacity: 1; filter: grayscale(0); }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 10px; }
  .control { display: flex; flex-direction: column; gap: 6px; }
  .control.full { grid-column: 1 / -1; }
  
  label { font-size: 9px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; display: flex; justify-content: space-between; align-items: center;}
  .val-display { color: var(--accent); font-weight: 700; }
  
  input[type="range"] { -webkit-appearance: none; width: 100%; height: 4px; background: var(--border); outline: none; border-radius: 2px; }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; background: var(--accent); border-radius: 50%; cursor: pointer; transition: transform 0.1s; }
  input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.2); }
  input[type="color"] { width: 100%; height: 26px; border: 1px solid var(--border); border-radius: 4px; cursor: pointer; background: transparent; padding: 0; }
  select, input[type="text"] { width: 100%; padding: 6px 8px; background: #111; border: 1px solid var(--border); color: var(--text-primary); font-family: inherit; font-size: 10px; border-radius: 4px; outline: none; }
  input[type="text"]:focus { border-color: var(--accent); }
  
  .toggle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .toggle-btn { background: #111; border: 1px solid var(--border); color: var(--text-muted); padding: 8px 4px; font-size: 9px; text-transform: uppercase; cursor: pointer; border-radius: 4px; text-align: center; font-weight: 600; transition: all 0.2s; }
  .toggle-btn:hover { border-color: #555; color: #ccc; }
  .toggle-btn.active { background: var(--text-primary); color: var(--bg-main); border-color: var(--text-primary); }
  
  .shape-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
  .shape-btn { background: #111; border: 1px solid var(--border); padding: 6px 0; font-size: 12px; cursor: pointer; border-radius: 4px; transition: all 0.2s; color: var(--text-muted); font-weight: 700; display:flex; align-items:center; justify-content:center;}
  .shape-btn:hover { border-color: #555; color: #ccc; }
  .shape-btn.active { background: var(--accent); color: #000; border-color: var(--accent); }

  .action-btn { width: 100%; padding: 12px; background: var(--accent); color: #000; font-family: inherit; font-weight: 700; font-size: 11px; border: none; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; border-radius: var(--radius); transition: all 0.2s; }
  .action-btn:hover { background: var(--accent-hover); transform: translateY(-1px); }
  .action-btn.secondary { background: transparent; border: 1px solid var(--text-primary); color: var(--text-primary); margin-top: auto; }
  .action-btn.secondary:hover { background: var(--text-primary); color: var(--bg-main); }
  .action-btn.random { background: #fff; margin-top: auto; }

  .preset-row { display: flex; gap: 4px; margin-bottom: 6px; flex-wrap: wrap; }
  .preset-row button { flex: 1; padding: 6px 2px; font-size: 8px; font-weight: 700; cursor: pointer; background: #222; color: #fff; border: 1px solid #444; border-radius: 4px; text-transform: uppercase; transition: 0.2s; text-align: center; }
  .preset-row button:hover { background: var(--accent); color: #000; border-color: var(--accent); }

  .right-panel { display: flex; flex-direction: column; padding: 20px; height: 100vh; overflow: hidden; }
  .preview-wrapper { flex: 1; min-height: 0; background: #111; border: 1px solid var(--border); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; background-image: radial-gradient(#222 1px, transparent 1px); background-size: 20px 20px; }
  
  #svgHost { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 10px; }
  #svgHost svg { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; box-shadow: 0 10px 40px rgba(0,0,0,0.8); transition: transform 0.2s; }
  
  .export-bar { margin-top: 16px; display: flex; gap: 12px; align-items: center; height: 42px; flex-shrink: 0; background: var(--panel-bg); padding: 8px; border: 1px solid var(--border); border-radius: var(--radius); }
  .export-bar select { width: auto; min-width: 130px; height: 100%; border: none; background: transparent; font-weight: 600;}
  .export-bar .action-btn { height: 100%; margin: 0; padding: 0 16px; display: flex; align-items: center; justify-content: center; width: auto; flex: 1;}

  .checkbox-wrap { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--text-muted); cursor: pointer; margin-top: 2px; }
  .checkbox-wrap input { accent-color: var(--accent); width: 14px; height: 14px; cursor: pointer; }

  .custom-presets-container { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .saved-presets-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .saved-preset-btn { background: #222; border: 1px solid var(--border); color: #ddd; padding: 6px; font-size: 9px; cursor: pointer; border-radius: 4px; display: flex; justify-content: space-between; align-items: center; text-transform: uppercase;}
  .saved-preset-btn:hover { background: #333; }
  .del-preset { color: #ff5555; background: none; border: none; cursor: pointer; font-weight: bold; padding: 0 4px; font-size: 12px;}
</style>
</head>
<body>

<div class="app-shell">
  <div class="left-panel">
    
    <div class="brand">
      <div>
        <h1>NODAL ENGINE</h1>
        <p>Síntesis Gráfica Paramétrica</p>
      </div>
      <div class="history-nav">
        <button id="btnUndo" disabled title="Deshacer (Ctrl+Z)">↩</button>
        <button id="btnRedo" disabled title="Rehacer (Ctrl+Y)">↪</button>
      </div>
    </div>

    <!-- Gestión de Presets -->
    <div class="section">
      <div class="section-header" style="margin-bottom:8px; cursor:pointer;" onclick="document.getElementById('presetsWrap').style.display = document.getElementById('presetsWrap').style.display==='none'?'block':'none'">
        <div class="section-title" style="color: var(--accent);">Estudio Presets (Galería)</div>
        <span style="font-size:10px; color:var(--text-muted);">▼</span>
      </div>
      <div id="presetsWrap">
          <div class="preset-row">
            <button onclick="applyStudioPreset('moire')">Moiré Óptico</button>
            <button onclick="applyStudioPreset('data')">Data Matrix</button>
            <button onclick="applyStudioPreset('typo')">Typo Scatter</button>
            <button onclick="applyStudioPreset('gooey')">Gooey Cells</button>
          </div>
          <div class="preset-row">
            <button onclick="applyStudioPreset('swiss')">Swiss Grid</button>
            <button onclick="applyStudioPreset('neon')">Neon Beats</button>
            <button onclick="applyStudioPreset('pastel')">Pastel Warp</button>
            <button onclick="applyStudioPreset('sand')">Cymatics Sand</button>
          </div>
          
          <div class="custom-presets-container" style="border-top: 1px solid #333; margin-top: 8px; padding-top: 8px;">
            <div style="display: flex; gap: 6px;">
              <input type="text" id="newPresetName" placeholder="Guardar mi preset...">
              <button class="action-btn" id="btnSavePreset" style="width: auto; padding: 6px 12px;">+</button>
            </div>
            <div class="saved-presets-grid" id="savedPresetsList"></div>
          </div>
      </div>
    </div>

    <!-- Visibilidad de Capas -->
    <div class="section" style="padding: 10px 14px;">
      <div class="grid-2">
        <div class="control full">
          <label class="checkbox-wrap" style="color:#fff;"><input type="checkbox" id="drawForeground" checked> 1. Mostrar Formas Principales</label>
          <label class="checkbox-wrap" style="color:#fff;"><input type="checkbox" id="waveEnabled" checked> 2. Mostrar Patrón Óptico (Fondo)</label>
        </div>
      </div>
      <div class="grid-2" style="margin-top:8px;">
        <button class="action-btn" id="btnSoloBg" style="background:#222; color: #fff; padding:6px; border:1px solid #444;">⚡ SOLO FONDO</button>
        <button class="action-btn" id="btnSoloFg" style="background:#222; color: #fff; padding:6px; border:1px solid #444;">⚡ SOLO FORMAS</button>
      </div>
    </div>

    <!-- Algoritmo Principal -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Matriz Estructural</div>
        <button class="lock-btn" data-lock="pattern" title="Bloquear matriz">🔓</button>
      </div>
      <div class="toggle-grid" id="patternToggles">
        <button class="toggle-btn active" data-val="chladni">Placa Chladni 2D</button>
        <button class="toggle-btn" data-val="chladniRadial">Chladni Polar Radial</button>
        <button class="toggle-btn" data-val="dataMatrix">Data Matrix (QuadTree)</button>
        <button class="toggle-btn" data-val="matrixWarp">Warp Matrix</button>
        <button class="toggle-btn" data-val="concentricWaves">Rizos Concéntricos</button>
        <button class="toggle-btn" data-val="sequencer">Secuenciador / Pistas</button>
        <button class="toggle-btn" data-val="ghostStrings">Hilos Transientes</button>
        <button class="toggle-btn" data-val="dataScatter">Dispersión de Datos</button>
      </div>
    </div>

    <!-- Composición Geométrica -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Composición Geométrica</div>
        <button class="lock-btn" data-lock="shapes" title="Bloquear formas">🔓</button>
      </div>
      <div class="shape-grid" id="shapeToggles">
        <button class="shape-btn active" data-val="circle" title="Círculos">●</button>
        <button class="shape-btn" data-val="rect" title="Cuadrados">■</button>
        <button class="shape-btn" data-val="triangle" title="Triángulos">▲</button>
        <button class="shape-btn" data-val="line" title="Líneas">|</button>
        <button class="shape-btn" data-val="hash" title="Trama / Hash">▤</button>
        <button class="shape-btn" data-val="text" title="Tipografía (Letras)">A</button>
      </div>
      <div class="grid-2" style="margin-top: 8px;">
        <div class="control full">
          <input type="text" id="customText" value="ITERATION" placeholder="Texto base (ej: N O D A L)">
        </div>
        <div class="control">
          <label>Rotación Estática <span class="val-display" id="valAngle">0</span>°</label>
          <input type="range" id="paramAngle" min="0" max="360" value="0" step="15">
        </div>
        <div class="control">
          <label>Textura Interna</label>
          <select id="paramFillType">
            <option value="solid" selected>Color Sólido</option>
            <option value="spectrogram">Espectrograma</option>
            <option value="stripesV">Líneas Verticales</option>
            <option value="stripesH">Líneas Horizontales</option>
            <option value="dots">Punteado (Halftone)</option>
          </select>
        </div>
        <div class="control" id="ctrlTexDen">
          <label>Densidad Trama <span class="val-display" id="valTexDen">4.0</span></label>
          <input type="range" id="paramTexDen" min="1" max="20" value="4" step="0.5">
        </div>
      </div>
    </div>

    <!-- Arte Óptico y Fondos -->
    <div class="section" style="border-color: var(--accent);">
      <div class="section-header">
        <div class="section-title" style="color:var(--accent);">Arte Óptico (Background)</div>
        <button class="lock-btn" data-lock="wave" title="Bloquear óptica">🔓</button>
      </div>
      <div class="grid-2">
        <div class="control full" id="ctrlWaveStyle">
          <label>Estilo Generativo</label>
          <select id="waveStyle">
            <option value="tin_warp">Moiré Distorsionado (Lente focal)</option>
            <option value="chladni_sand">Arena Acústica (Cymatics puro)</option>
            <option value="chladni_bg">Chladni Óptico (Halftone)</option>
            <option value="pixel_grid">Trama Pixelada (Ref Iteration)</option>
            <option value="concentric">Anillos Radiales</option>
            <option value="sine">Ondas Fluidas</option>
          </select>
        </div>
        <div class="control" id="ctrlWaveRows">
          <label>Densidad/Pistas <span class="val-display" id="valWaveRows">24</span></label>
          <input type="range" id="waveRows" min="2" max="150" value="24" step="1">
        </div>
        <div class="control" id="ctrlWaveAmp">
          <label>Amplitud Curva <span class="val-display" id="valWaveAmp">2.0</span></label>
          <input type="range" id="waveAmp" min="0" max="8" value="2.0" step="0.1">
        </div>
        <div class="control" id="ctrlWaveFreq">
          <label>Frecuencia Ola <span class="val-display" id="valWaveFreq">3.0</span></label>
          <input type="range" id="waveFreq" min="0.5" max="20" value="3" step="0.5">
        </div>
        <div class="control" id="ctrlWaveBlur">
          <label>Blur Fondo <span class="val-display" id="valWaveBlur">0.0</span></label>
          <input type="range" id="waveBlur" min="0" max="20" value="0" step="0.5">
        </div>
        <div class="control full" id="ctrlWaveColor">
          <label>Color Óptico</label>
          <input type="color" id="waveColor" value="#333333">
        </div>
        <div class="control full" id="ctrlWaveSync">
          <label class="checkbox-wrap" style="color:var(--accent);">
            <input type="checkbox" id="waveSyncColor" checked> Fusión Óptica (El fondo recorta la figura)
          </label>
        </div>
      </div>
    </div>

    <!-- Morfología -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Física y Masa</div>
        <button class="lock-btn" data-lock="morph" title="Bloquear morfología">🔓</button>
      </div>
      <div class="grid-2">
        <div class="control" id="ctrlN">
          <label>Frecuencia N <span class="val-display" id="valN">4.0</span></label>
          <input type="range" id="paramN" min="1" max="15" value="4" step="0.5">
        </div>
        <div class="control" id="ctrlM">
          <label>Frecuencia M <span class="val-display" id="valM">7.0</span></label>
          <input type="range" id="paramM" min="1" max="15" value="7" step="0.5">
        </div>
        <div class="control full">
          <label>Densidad de Formas <span class="val-display" id="valDen">1800</span></label>
          <input type="range" id="paramDen" min="50" max="8000" value="1800" step="50">
        </div>
        <div class="control">
          <label>Tamaño Mín. <span class="val-display" id="valMinS">0.0</span></label>
          <input type="range" id="paramMinS" min="0" max="30" value="0" step="0.5">
        </div>
        <div class="control">
          <label>Tamaño Máx. <span class="val-display" id="valMaxS">12.0</span></label>
          <input type="range" id="paramMaxS" min="0.5" max="120" value="12" step="0.5">
        </div>
        <div class="control full">
          <label>Corte (Threshold) <span class="val-display" id="valThresh">0.35</span></label>
          <input type="range" id="paramThresh" min="0.01" max="1.5" value="0.35" step="0.01">
        </div>
      </div>
    </div>

    <!-- Grilla y Deformación -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Modulación Espacial (Warp)</div>
        <button class="lock-btn" data-lock="grid" title="Bloquear grilla">🔓</button>
      </div>
      <div class="grid-2">
        <div class="control">
          <label>Warp X <span class="val-display" id="valWarpX">0.00</span></label>
          <input type="range" id="warpX" min="0" max="0.5" value="0.0" step="0.01">
        </div>
        <div class="control">
          <label>Warp Y <span class="val-display" id="valWarpY">0.00</span></label>
          <input type="range" id="warpY" min="0" max="0.5" value="0.0" step="0.01">
        </div>
        <div class="control full">
          <label class="checkbox-wrap"><input type="checkbox" id="warpTargetFg" checked> Deformar Figuras</label>
          <label class="checkbox-wrap"><input type="checkbox" id="warpTargetBg" checked> Deformar Fondo Óptico / Grilla</label>
        </div>
        
        <div class="control" style="grid-column: 1 / -1; margin-top:8px;">
          <label style="border-bottom: 1px solid var(--border); padding-bottom:4px; margin-bottom:4px;">Grilla de Inversión Estática</label>
        </div>
        <div class="control">
          <label>Celdas Divisorias</label>
          <select id="paramGridN">
            <option value="1">1 × 1 (Off)</option>
            <option value="2">2 × 2</option>
            <option value="4" selected>4 × 4</option>
            <option value="6">6 × 6</option>
            <option value="12">12 × 12 (Densa)</option>
            <option value="24">24 × 24 (Micro)</option>
          </select>
        </div>
        <div class="control">
          <label class="checkbox-wrap" style="margin-top:16px;"><input type="checkbox" id="paramGridLines"> Trazar ejes grilla</label>
        </div>
      </div>
    </div>

    <!-- Lentes y Estilo -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Lentes, Efectos y Paleta</div>
        <button class="lock-btn" data-lock="style" title="Bloquear estilo">🔓</button>
      </div>
      <div class="grid-2">
        <div class="control">
          <label>Enfoque (Blur) <span class="val-display" id="valBlur">0.0</span></label>
          <input type="range" id="paramBlur" min="0" max="15" value="0" step="0.5">
        </div>
        <div class="control">
          <label>Fusión Líquida (Gooey) <span class="val-display" id="valGooey">0</span></label>
          <input type="range" id="paramGooey" min="0" max="30" value="0" step="1">
        </div>
        <div class="control full">
          <label>Ruido Dinámico <span class="val-display" id="valNoise">0.15</span></label>
          <input type="range" id="paramNoise" min="0" max="1" value="0.15" step="0.05">
        </div>
        <div class="control full">
          <label>Modo de Fusión (Blend Mode)</label>
          <select id="paramBlend">
            <option value="normal" selected>Normal</option>
            <option value="difference">Exclusión / Inversión</option>
            <option value="multiply">Multiplicar (Tintas)</option>
          </select>
        </div>
        <div class="control full">
          <label>Paleta Cromática</label>
          <select id="paramPalMode">
            <option value="1">Monocromático (Solo A)</option>
            <option value="2">Bicromático (A + B)</option>
            <option value="3" selected>Tricromático (A + B + C)</option>
          </select>
        </div>
        <div class="control"><label>Color A</label><input type="color" id="colA" value="#4CAF50"></div>
        <div class="control" id="wrapColB"><label>Color B</label><input type="color" id="colB" value="#FF3366"></div>
        <div class="control" id="wrapColC"><label>Color C</label><input type="color" id="colC" value="#111111"></div>
        <div class="control"><label>Fondo Base</label><input type="color" id="colBg" value="#E8E6E1"></div>
        <div class="control full">
          <label class="checkbox-wrap"><input type="checkbox" id="paramTrans"> Transparencia (Vector PNG Libre)</label>
        </div>
      </div>
    </div>

    <button class="action-btn random" id="btnRandom">MUTAR EXPERIMENTO 🎲</button>
  </div>

  <!-- Panel de Vista Previa -->
  <div class="right-panel">
    <div class="preview-wrapper">
      <div id="svgHost"></div>
    </div>
    <div class="export-bar">
      <select id="exportRes">
        <option value="1080">Redes (1080px)</option>
        <option value="2160" selected>Print HQ (2160px)</option>
        <option value="4000">Ultra (4000px)</option>
        <option value="6000">Master (6000px)</option>
        <option value="8000">Colosal (8000px)</option>
      </select>
      <button class="action-btn secondary" id="btnJpg">⬇ JPG</button>
      <button class="action-btn secondary" id="btnPng">⬇ PNG</button>
      <button class="action-btn" id="btnSvg">⬇ SVG</button>
    </div>
  </div>
</div>

<script>
  // Estado global y candados
  const state = {
    pattern: 'chladni',
    shapes: ['circle'],
    seed: Math.floor(Math.random() * 1e9),
    W: 1000,
    H: 1000,
    locks: { pattern: false, shapes: false, morph: false, wave: false, grid: false, style: false }
  };

  let historyStack = [];
  let historyIndex = -1;
  let isApplyingHistory = false;

  function captureState() {
    const s = {
      pattern: state.pattern,
      shapes: [...state.shapes],
      seed: state.seed,
      locks: {...state.locks},
      ui: {}
    };
    document.querySelectorAll('input:not([type="button"]):not([type="text"]), select').forEach(el => {
      if (el.id && el.id !== 'newPresetName') {
        s.ui[el.id] = el.type === 'checkbox' ? el.checked : el.value;
      }
    });
    s.ui['customText'] = document.getElementById('customText').value;
    return JSON.stringify(s);
  }

  function recordHistory() {
    if (isApplyingHistory) return;
    const current = captureState();
    if (historyIndex >= 0 && historyStack[historyIndex] === current) return;
    
    historyStack = historyStack.slice(0, historyIndex + 1);
    historyStack.push(current);
    historyIndex++;
    updateHistoryBtns();
  }

  function updateHistoryBtns() {
    document.getElementById('btnUndo').disabled = historyIndex <= 0;
    document.getElementById('btnRedo').disabled = historyIndex >= historyStack.length - 1;
  }

  function syncLabels() {
    const getDisp = (id, decimal) => {
        let el = document.getElementById(id);
        if(!el) return '0';
        return Number(el.value).toFixed(decimal);
    };
    document.getElementById('valN').innerText = getDisp('paramN', 1);
    document.getElementById('valM').innerText = getDisp('paramM', 1);
    document.getElementById('valDen').innerText = document.getElementById('paramDen').value;
    document.getElementById('valMinS').innerText = getDisp('paramMinS', 1);
    document.getElementById('valMaxS').innerText = getDisp('paramMaxS', 1);
    document.getElementById('valThresh').innerText = getDisp('paramThresh', 2);
    document.getElementById('valAngle').innerText = document.getElementById('paramAngle').value;
    document.getElementById('valWarpX').innerText = getDisp('warpX', 2);
    document.getElementById('valWarpY').innerText = getDisp('warpY', 2);
    document.getElementById('valBlur').innerText = getDisp('paramBlur', 1);
    document.getElementById('valGooey').innerText = document.getElementById('paramGooey').value;
    document.getElementById('valNoise').innerText = getDisp('paramNoise', 2);
    document.getElementById('valWaveAmp').innerText = getDisp('waveAmp', 1);
    document.getElementById('valWaveFreq').innerText = getDisp('waveFreq', 1);
    document.getElementById('valWaveRows').innerText = document.getElementById('waveRows').value;
    document.getElementById('valWaveBlur').innerText = getDisp('waveBlur', 1);
    document.getElementById('valTexDen').innerText = getDisp('paramTexDen', 1);
  }

  function restoreState(stateStr) {
    if (!stateStr) return;
    isApplyingHistory = true;
    const s = JSON.parse(stateStr);
    
    state.pattern = s.pattern;
    state.shapes = [...s.shapes];
    state.seed = s.seed;
    state.locks = {...s.locks};
    
    Object.keys(s.ui).forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        if (el.type === 'checkbox') el.checked = s.ui[id];
        else el.value = s.ui[id];
      }
    });
    
    document.querySelectorAll('#patternToggles .toggle-btn').forEach(b => b.classList.toggle('active', b.dataset.val === state.pattern));
    document.querySelectorAll('#shapeToggles .shape-btn').forEach(b => b.classList.toggle('active', state.shapes.includes(b.dataset.val)));
    
    document.querySelectorAll('.lock-btn').forEach(btn => {
       const key = btn.dataset.lock;
       btn.classList.toggle('locked', state.locks[key]);
       btn.innerText = state.locks[key] ? '🔒' : '🔓';
    });

    document.getElementById('wrapColB').style.display = (s.ui.paramPalMode === '2' || s.ui.paramPalMode === '3') ? 'flex' : 'none';
    document.getElementById('wrapColC').style.display = s.ui.paramPalMode === '3' ? 'flex' : 'none';
    
    syncLabels();
    updateControlsState();
    render();
    updateHistoryBtns();
    isApplyingHistory = false;
  }

  document.getElementById('btnUndo').addEventListener('click', () => {
    if (historyIndex > 0) { historyIndex--; restoreState(historyStack[historyIndex]); }
  });
  document.getElementById('btnRedo').addEventListener('click', () => {
    if (historyIndex < historyStack.length - 1) { historyIndex++; restoreState(historyStack[historyIndex]); }
  });

  window.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
      e.preventDefault();
      if (e.shiftKey) {
        if (historyIndex < historyStack.length - 1) { historyIndex++; restoreState(historyStack[historyIndex]); }
      } else {
        if (historyIndex > 0) { historyIndex--; restoreState(historyStack[historyIndex]); }
      }
    } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') {
      e.preventDefault();
      if (historyIndex < historyStack.length - 1) { historyIndex++; restoreState(historyStack[historyIndex]); }
    }
  });

