      const span = document.createElement('span');
      span.innerText = name;
      span.style.flex = "1";
      span.onclick = () => { restoreState(saved[name]); recordHistory(); };
      
      const del = document.createElement('button');
      del.className = 'del-preset';
      del.innerText = '×';
      del.title = 'Eliminar';
      del.onclick = (e) => {
        e.stopPropagation();
        delete saved[name];
        localStorage.setItem('nodal_presets', JSON.stringify(saved));
        loadSavedCustomPresets();
      };
      
      btn.appendChild(span);
      btn.appendChild(del);
      grid.appendChild(btn);
    });
